<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>REGOwintergarden</RootNamespace>
    <AssemblyName>REGOwintergarden.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Ohne -windows im Zielframework: dieser Teil laeuft auf jedem
         Betriebssystem, das .NET 8 kennt - auch auf einem Raspberry Pi.
         Genau deshalb liegt er in einem eigenen Projekt: die Regeln, der
         Sonnenstand und der KNX-Tunnel haben mit Fenstern nichts zu tun, und
         ein Wintergarten wartet nicht darauf, dass ein Windows-Rechner
         laeuft. -->

    <VersionPrefix>1.0</VersionPrefix>
    <BuildStamp Condition="'$(BuildStamp)' == ''">$([System.DateTime]::Now.ToString("ddMMyy"))</BuildStamp>
    <Version>1.0.0</Version>
    <InformationalVersion>$(VersionPrefix).$(BuildStamp)</InformationalVersion>
    <Company>Stephan Ruf</Company>
    <Authors>Stephan Ruf</Authors>
    <Product>REGOwintergarden</Product>
    <Copyright>Copyright 2026 Stephan Ruf</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="REGOwintergarden" />
    <InternalsVisibleTo Include="REGOwintergarden.Daemon" />
    <InternalsVisibleTo Include="REGOwintergarden.Tests" />
  </ItemGroup>

</Project>
