<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="1.0.0.0" name="REGOsound.app" />

  <!--
    Die DPI-Einstellung steht bewusst NICHT hier, sondern als
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode> in der
    .csproj: der WinForms-Analyzer (WFAC010) lehnt DPI-Angaben im Manifest
    ab, sobald UseWindowsForms gesetzt ist - und das ist es hier wegen des
    Traybar-Symbols.

    PerMonitorV2 zaehlt fuer diese Anwendung: das Cover im Vollbild wuerde
    sonst auf einem hochaufloesenden Schirm vom System hochskaliert statt
    scharf gezeichnet.
  -->

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

</assembly>
