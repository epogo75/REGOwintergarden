<Window x:Class="REGOwintergarden.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REGOwintergarden" Height="820" Width="1280"
        MinHeight="620" MinWidth="1000"
        Background="{StaticResource Flaeche}">

  <DockPanel Margin="16">

    <!-- Kopfzeile: der Weg zum Bus und der Zustand der Automatik. -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Gruppenkarte}" Margin="0,0,0,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Gateway" Style="{StaticResource Beschriftung}" Width="80" />
          <TextBox x:Name="GatewayBox" Style="{StaticResource Adressfeld}" Width="200" Margin="0,0,8,0" />
          <Button x:Name="ButtonConnect" Style="{StaticResource KnopfStark}" Content="Verbinden"
                  Click="OnConnectClick" />
          <Button Style="{StaticResource Knopf}" Content="Zustand abfragen" Click="OnReadClick" />
          <Button Style="{StaticResource Knopf}" Content="Ueber…" Click="OnAboutClick" Margin="0" />
        </StackPanel>
        <TextBlock x:Name="LinkText" Style="{StaticResource Hinweis}" Margin="80,8,0,0" />
        <TextBlock x:Name="StatusText" Style="{StaticResource Hinweis}" Margin="80,2,0,0" />
      </StackPanel>
    </Border>

    <TabControl x:Name="Tabs" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Linie}">
      <TabItem x:Name="TabUebersicht" Header="Uebersicht" Padding="12,6" />
      <TabItem x:Name="TabAntriebe" Header="Antriebe" Padding="12,6" />
      <TabItem x:Name="TabAnlage" Header="Anlage" Padding="12,6" />
      <TabItem x:Name="TabZeiten" Header="Zeitschaltuhr" Padding="12,6" />
      <TabItem x:Name="TabProtokoll" Header="Protokoll" Padding="12,6" />
    </TabControl>

  </DockPanel>
</Window>
