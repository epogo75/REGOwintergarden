<Window x:Class="REGOwintergarden.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REGOwintergarden" Height="860" Width="1320"
        MinHeight="640" MinWidth="1020"
        Background="{StaticResource Flaeche}">

  <DockPanel>

    <!-- Die Fusszeile sagt in einem Satz, ob ueberhaupt gefahren werden kann.
         Mehr Technik steht nicht auf der Bedienseite - das Gateway traegt man
         einmal ein, und danach interessiert nur noch, ob es steht. -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Ruhe}"
            BorderBrush="{StaticResource Linie}" BorderThickness="0,1,0,0"
            Padding="16,6,16,6">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="LinkText" DockPanel.Dock="Left" Style="{StaticResource Hinweis}"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Style="{StaticResource Hinweis}" TextAlignment="Right"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" Margin="16,16,16,8"
                Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Linie}">
      <TabItem x:Name="TabBedienung" Header="Bedienung" Padding="16,8" />
      <TabItem x:Name="TabKonfiguration" Header="Konfiguration" Padding="16,8" />
    </TabControl>

  </DockPanel>
</Window>
